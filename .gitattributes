# Normalización de finales de línea.
# El contenedor corre sobre Linux: los archivos que interpreta el sistema
# (Dockerfile, configs, scripts, SQL, PHP) deben ir siempre con LF.
* text=auto eol=lf

Dockerfile      text eol=lf
*.sh            text eol=lf
*.conf          text eol=lf
*.ini           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.php           text eol=lf
*.sql           text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.md            text eol=lf

# Binarios: sin conversión
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
