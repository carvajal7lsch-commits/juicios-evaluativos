# ================================================================
# Variables de entorno — Juicios Evaluativos
# Cópialas al panel "Environment" de Dokploy (o a un .env local).
# ================================================================

# Puerto del host donde escucha la app (solo en 127.0.0.1; nginx hace de
# proxy hacia él). Tiene que estar libre: comprobar con `sudo ss -ltnp`.
# Si lo cambias, actualiza también proxy_pass en deploy/nginx/juicios.conf.
APP_PORT=9081

# IMPORTANTE: los scripts de sql/ hacen "USE juicios_evaluativos",
# así que DB_NAME debe mantenerse con este valor para que la carga
# inicial del esquema funcione.
DB_NAME=juicios_evaluativos

DB_USER=juicios
DB_PASS=CAMBIA_ESTA_CLAVE
DB_ROOT_PASS=CAMBIA_ESTA_CLAVE_ROOT
